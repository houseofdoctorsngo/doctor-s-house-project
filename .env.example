# Local development: copy to .env.local. Never commit real secrets.
VITE_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SB_SECRET_KEY
# Existing installations may keep SUPABASE_SERVICE_ROLE_KEY as a legacy alias.
# disabled, test, or live. Enable only after applying SQL and testing.
PAYMENTS_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Required in production for public forms.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
